{
  "name": "marked-terminal",
  "version": "7.3.0",
  "description": "A custom render for marked to output to the Terminal",
  "main": "./dist/index.cjs",
  "browser": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "node": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "default": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "type": "module",
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "build": "rollup -c",
    "prepack": "npm run build",
    "test": "npm run build && cross-env FORCE_HYPERLINK=0 mocha tests/*.js --reporter spec"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "marked",
    "render",
    "terminal",
    "markdown",
    "markdown-to-terminal"
  ],
  "author": "Mikael Brevik",
  "license": "MIT",
  "peerDependencies": {
    "marked": ">17 <=18"
  },
  "dependencies": {
    "ansi-escapes": "^7.3.0",
    "ansi-regex": "^6.2.2",
    "chalk": "^5.6.2",
    "cli-highlight": "^2.1.11",
    "cli-table3": "^0.6.5",
    "node-emoji": "^2.2.0",
    "supports-hyperlinks": "^4.5.0"
  },
  "directories": {
    "example": "example"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.0.1",
    "cross-env": "^7.0.3",
    "marked": "^18.0.5",
    "mocha": "^11.0.1",
    "rollup": "^4.29.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mikaelbr/marked-terminal.git"
  },
  "bugs": {
    "url": "https://github.com/mikaelbr/marked-terminal/issues"
  },
  "homepage": "https://github.com/mikaelbr/marked-terminal"
}
